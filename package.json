	},
	"devDependencies": {
		"@nuxt/eslint": "1.17.0",
		"@nuxtjs/google-fonts": "3.2.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "25.3.0",
		"daisyui": "^5.7.50",
		"h3": "^1.15.5",
		"prettier": "3.9.10",
		"prettier-plugin-tailwindcss": "0.7.2",
