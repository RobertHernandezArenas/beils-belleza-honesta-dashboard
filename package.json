{
	"name": "beils-belleza-honesta-dashboard",
	"type": "module",
	"private": true,
	"author": "RobertHernandezArenas",
	"scripts": {
		"build": "npm run prisma:generate && nuxt build",
		"dev": "nuxt dev",
		"generate": "npm run prisma:generate && nuxt generate",
		"preview": "nuxt preview",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "nuxi typecheck",
		"test": "tsx --test tests/*.test.ts",
		"postinstall": "nuxt prepare",
		"seed": "npx tsx --env-file=.env ./seeds/seed-db.ts",
		"seed:admin": "npx tsx --env-file=.env ./seeds/admin-seed.ts",
		"db:check": "npx tsx --env-file=.env ./scripts/check-db.ts",
		"prisma:init": "npx prisma init --datasource-provider mysql --output ./generated",
		"prisma:pull": "npx prisma db pull --schema prisma/schema.prisma",
		"prisma:generate": "npx prisma generate --schema prisma/schema.prisma",
		"prisma:migrate": "npx prisma migrate dev --name init --schema prisma/schema.prisma",
		"prisma:reset": "npx prisma migrate reset --schema prisma/schema.prisma",
		"db:push": "npx prisma db push",
		"db:fix": "npx tsx --env-file=.env ./scripts/fix-db-tables.ts",
		"db:reset-empty": "npx tsx --env-file=.env ./seeds/empty-db.ts",
		"plesk-install": "npx pnpm install"
	},
	"dependencies": {
		"@nuxt/fonts": "0.13.0",
		"@nuxt/image": "2.0.0",
		"@pinia/nuxt": "0.11.3",
		"@prisma/adapter-mariadb": "7.4.1",
		"@prisma/client": "7.4.1",
		"@tanstack/vue-query": "5.92.9",
		"@vueuse/core": "^14.2.1",
		"aos": "2.3.4",
		"bcryptjs": "^3.0.3",
		"dexie": "^4.3.0",
		"dotenv": "17.3.1",
		"echarts": "^6.0.0",
		"gsap": "^3.14.2",
		"jsonwebtoken": "^9.0.3",
		"jspdf": "4.2.0",
		"lucide-vue-next": "0.564.0",
		"mariadb": "^3.5.1",
		"nuxt": "4.3.1",
		"pinia": "3.0.4",
		"qrcode.vue": "^3.8.0",
		"soap": "^1.8.0",
		"vue": "3.5.28",
		"vue-advanced-cropper": "^2.8.9",
		"vue-echarts": "^8.0.1",
		"vue-i18n": "11.2.8",
		"vue-router": "4.6.4",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@nuxt/eslint": "1.15.1",
		"@nuxtjs/google-fonts": "3.2.0",
		"@tailwindcss/vite": "4.1.18",
		"@types/aos": "3.0.7",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "25.3.0",
		"daisyui": "^5.5.19",
		"h3": "^1.15.5",
		"prettier": "3.8.1",
		"prettier-plugin-tailwindcss": "0.7.2",
		"prisma": "7.4.1",
		"sharp": "^0.34.5",
		"tailwindcss": "4.1",
		"tsx": "4.21.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vue-devtools-stub": "^0.1.0",
		"vue-tsc": "^3.3.9"
	}
}