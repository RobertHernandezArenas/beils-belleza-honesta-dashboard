		"@tanstack/vue-query": "5.104.5",
		"@vueuse/core": "^14.2.1",
		"bcryptjs": "^3.0.3",
		"dotenv": "17.3.1",
		"echarts": "^6.1.0",
		"gsap": "^3.15.0",
