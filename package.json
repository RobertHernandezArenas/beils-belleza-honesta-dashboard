{
	"name": "beils-belleza-honesta-dashboard",
	"type": "module",
	"private": true,
	"author": "RobertHernandezArenas",
	"engines": {
		"node": "^22.22.3 || ^24.15.0 || >=26.0.0"
	},
	"scripts": {
		"build": "prisma generate && nuxt build",
		"dev": "nuxt dev",
		"generate": "prisma generate && nuxt generate",
		"preview": "nuxt preview",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "nuxi typecheck",
		"test": "tsx --test tests/*.test.ts",
		"postinstall": "nuxt prepare",
		"seed": "tsx --env-file=.env ./seeds/seed-db.ts",
		"seed:admin": "tsx --env-file=.env ./seeds/admin-seed.ts",
		"db:check": "tsx --env-file=.env ./scripts/check-db.ts",
		"db:fix": "tsx --env-file=.env ./scripts/fix-db-tables.ts",
		"uploads:migrate": "tsx --env-file=.env ./scripts/migrate-uploads-private.ts",
		"uploads:migrate:apply": "tsx --env-file=.env ./scripts/migrate-uploads-private.ts --apply",
		"prisma:pull": "prisma db pull",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev",
		"prisma:reset": "prisma migrate reset",
		"db:push": "prisma db push",
		"db:reset-empty": "tsx --env-file=.env ./seeds/empty-db.ts",
		"tickets:verify": "tsx --env-file=.env ./scripts/verify-ticket-numbers.ts",
		"tickets:migrate": "tsx --env-file=.env ./scripts/migrate-ticket-numbers.ts",
		"tickets:migrate:apply": "tsx --env-file=.env ./scripts/migrate-ticket-numbers.ts --apply",
		"tickets:sync-agenda": "tsx --env-file=.env ./scripts/sync-bookings-sales.ts",
		"tickets:sync-agenda:apply": "tsx --env-file=.env ./scripts/sync-bookings-sales.ts --apply"
	},
	"dependencies": {
		"@nuxt/fonts": "0.13.0",
